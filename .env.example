# ---- LLM: pick one provider -------------------------------------------------------------
# GROQ | GOOGLE_GENAI | OLLAMA | VLLM
LLM_PROVIDER="GROQ"

GROQ_MODEL_ID="qwen/qwen3.8-27b"
GROQ_API_KEY=

GOOGLE_MODEL_ID="gemini-2.5-flash"
GOOGLE_API_KEY=

OLLAMA_MODEL_ID="qwen3:1.7b"
OLLAMA_BASE_URL="http://localhost:11434"

# vLLM serves an OpenAI-compatible API (AWQ 4-bit model)
VLLM_MODEL_ID="Qwen/Qwen3-8B-AWQ"
VLLM_BASE_URL="http://localhost:8001/v1"

# ---- retrieval --------------------------------------------------------------------------
EMBEDDING_MODEL_PROVIDER="HUGGINGFACE"
EMBEDDING_MODEL_ID="BAAI/bge-m3"
RERANKER_MODEL_ID="BAAI/bge-reranker-v2-m3"
RERANKER_DEVICE="cpu"
TOP_K=5
RETRIEVAL_CANDIDATES=20
QDRANT_URL="http://localhost:6333"

HUGGING_FACE_HUB_TOKEN=

# ---- observability ----------------------------------------------------------------------
# Langfuse (self-hosted, http://localhost:3000): create a project, copy its keys here
# self-hosted (docker compose -f docker-compose.monitoring.yml up) or https://cloud.langfuse.com
LANGFUSE_HOST="http://localhost:3000"
LANGFUSE_BASE_URL="http://localhost:3000"
LANGFUSE_TRACING_ENVIRONMENT="development"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# RAGAS judge used by the monitor / sweep scripts (any OpenAI-compatible endpoint)
# RAGAS judge: groq | gemini | openrouter | openai | vllm
JUDGE_PROVIDER="groq"
# judge answers were truncated at 900 tokens (IncompleteOutputException): start at 4096, auto-doubles
JUDGE_MAX_TOKENS=4096
# Groq Qwen3 thinking off (optional): JUDGE_EXTRA_BODY={"reasoning_effort":"none"}
# leave JUDGE_BASE_URL/JUDGE_API_KEY/JUDGE_MODEL empty to use the provider preset + its own key
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
OPENROUTER_API_KEY=
GOOGLE_RAGAS_JUDGE_MODEL="gemini-2.5-flash"

# alerting: faithfulness below this => notification (Slack/Discord/Teams incoming webhook)
FAITHFULNESS_ALERT_THRESHOLD=0.80
ALERT_WEBHOOK_URL=
PUSHGATEWAY_URL="http://localhost:9091"

# cost model (USD per 1M tokens), see src/monitoring/cost.py
# PRICE_VLLM_INPUT_PER_1M=0.10
# PRICE_VLLM_OUTPUT_PER_1M=0.25
EMBEDDING_DEVICE="cpu"   # cuda:0 when a GPU is available
